# Example ONLY. Keep real environment configuration outside GitHub.
# Use a Linux service account with only the database permissions needed to back up.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=college_portal
PGUSER=college_backup
# Create /home/<backup-user>/.pgpass with chmod 600 and correct PostgreSQL credentials.
# Never put .pgpass in the repository. See README.
PGPASSFILE=/home/collegebackup/.pgpass
BACKUP_DIR=/var/backups/college-portal
